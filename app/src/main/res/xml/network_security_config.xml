<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Radio stations often use plain HTTP, so it stays allowed in general -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- The app's own data must always use HTTPS -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="true">radio-browser.info</domain>
    </domain-config>
</network-security-config>